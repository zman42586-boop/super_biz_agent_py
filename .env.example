# OpenAI-compatible LLM API
DASHSCOPE_API_KEY=replace_with_your_api_key
DASHSCOPE_API_BASE=https://api.deepseek.com/v1
DASHSCOPE_MODEL=deepseek-v4-flash
RAG_MODEL=deepseek-v4-flash
EVAL_JUDGE_MODEL=deepseek-v4-pro
MEMORY_AUTO_APPROVE_SCORE=0.80
MEMORY_REJECT_SCORE=0.45

# Local embedding and reranker
DASHSCOPE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# RAG retrieval
RAG_TOP_K=5
RAG_DENSE_CANDIDATES=20
RAG_SPARSE_CANDIDATES=20
RAG_RERANK_CANDIDATES=20
RAG_RRF_K=60
RAG_RERANKER_ENABLED=true
RAG_RERANKER_WEIGHT=0.20
RAG_CONFIDENCE_RANK_WINDOW=10
RAG_SEMANTIC_EVIDENCE_THRESHOLD=0.55
RAG_RETRY_ON_LOW_CONFIDENCE=true
CHUNK_MAX_TOKENS=420
CHUNK_OVERLAP_TOKENS=64

# MCP and alert service
MCP_MONITOR_URL=http://localhost:8004/mcp
ALERT_WEBHOOK_TOKEN=replace_with_a_random_token
FASTAPI_BASE_URL=http://127.0.0.1:9900

# Optional SMTP alerting
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# MATLAB process polling
POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=5
ONCALL_MONITOR_PROCESS=MATLAB.exe
ONCALL_MONITOR_CRASH_DIR=C:\Users\YOUR_NAME\AppData\Roaming\MathWorks\MATLAB\CrashDumps
ONCALL_MONITOR_CRASH_PATTERN=matlab_crash_dump.*
ONCALL_HEARTBEAT_TIMEOUT_SEC=60
ONCALL_HEARTBEAT_CHECK_INTERVAL_SEC=10
ONCALL_HEARTBEAT_SUSPECTED_SEC=30
ONCALL_AUTO_DIAGNOSIS=true

# Independent incremental MATLAB runtime log upload (not Crash Dump)
# Configure MATLAB to write a diary/runtime log. Include rotated files in the glob.
MATLAB_LOG_GLOBS=
MATLAB_LOG_INTERVAL_SEC=2
MATLAB_LOG_MAX_FILES=8
MATLAB_LOG_READ_BYTES=65536
MATLAB_LOG_SPOOL_ENTRIES=128
MATLAB_LOG_SPOOL_BYTES=262144
ONCALL_HISTORY_TTL_SEC=7200
ONCALL_HISTORY_METRICS_PER_HOST=1600
ONCALL_HISTORY_LOGS_PER_HOST=400
ONCALL_HISTORY_PAYLOAD_BYTES=65536
ONCALL_HISTORY_LOG_CHARS=4096

# Durable Agent Harness and LoopGuard
HARNESS_MYSQL_HOST=127.0.0.1
HARNESS_MYSQL_PORT=3306
HARNESS_MYSQL_DATABASE=superbiz_agent
HARNESS_MYSQL_USER=superbiz
HARNESS_MYSQL_PASSWORD=replace_with_your_mysql_password
HARNESS_AUTO_CREATE_SCHEMA=true
HARNESS_POLL_INTERVAL_SEC=1
HARNESS_LEASE_SEC=30
HARNESS_RECOVERY_INTERVAL_SEC=5
HARNESS_RUN_TIMEOUT_SEC=300
HARNESS_MAX_STEPS=8
HARNESS_MAX_TOOL_CALLS=20
HARNESS_MAX_REPEATED_STEPS=2
HARNESS_MAX_REPEATED_TOOL_CALLS=3
HARNESS_MIN_DYNAMIC_CALL_INTERVAL_SEC=5
HARNESS_MAX_NO_PROGRESS_STEPS=2
# Effective graph limit is at least 3*MAX_STEPS + 2*(1+MAX_CORRECTIONS) + 4.
HARNESS_GRAPH_RECURSION_LIMIT=32
HARNESS_VERIFICATION_MAX_CORRECTIONS=2
HARNESS_VERIFICATION_TIMEOUT_SEC=30
HARNESS_EVIDENCE_HISTORY_SEC=7200
HARNESS_EVIDENCE_FUTURE_SEC=60

# Optional LibreHardwareMonitor temperature polling
ONCALL_TEMP_ENABLED=false
LHM_BASE_URL=http://127.0.0.1:8085
LHM_SENSOR_NAME_CONTAINS=CCDs Max (Tdie)
ONCALL_TEMP_THRESHOLD_C=85
ONCALL_TEMP_DURATION_SEC=60
ONCALL_TEMP_COOLDOWN_SEC=120
EMERGENCY_SNAPSHOT_TEMP_C=85
